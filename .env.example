# Copia a .env para correr en local. En producción NADA de esto vive en archivo:
# lo inyecta el gestor de secretos (Vault / AWS Secrets Manager / K8s Secrets) como variables de entorno.

CONCILIADOR_MODO=sombra            # sombra | asistida | autonoma
FUENTE_BANCO=portal_rpa            # portal_rpa | api | archivo
BLOQUEADOR_CORE=ui_rpa             # ui_rpa | api
LLM_PROVEEDOR=nulo                 # nulo | anthropic | openai_compatible
LLM_MODELO=claude-sonnet-5-5
# LLM_URL=http://modelo-interno:8000/v1   # solo openai_compatible
# LLM_API_KEY=
# ANTHROPIC_API_KEY=

BANCO_PORTAL_URL=http://localhost:8001
BANCO_PORTAL_USUARIO=operaciones
BANCO_PORTAL_CLAVE=portal-demo
BANCO_API_URL=http://localhost:8001/api/v2
BANCO_API_TOKEN=token-banco-demo
# BANCO_CSV_MANUAL=datos/movimientos_manual.csv

CORE_URL=http://localhost:8002
CORE_API_TOKEN=token-core-demo
CORE_UI_USUARIO=analista
CORE_UI_CLAVE=core-demo

LIBRO_MAYOR_RUTA=datos/libro_mayor.sqlite
EVIDENCIA_RUTA=evidencia
# SLACK_WEBHOOK_URL=
HORA_LIMITE=06:00
UMBRAL_APROBACION_CENTAVOS=5000000   # $50,000.00
MAX_CONTRACARGOS_COMERCIO_DIA=3
TOLERANCIA_DIAS=1
TOLERANCIA_MONTO_CENTAVOS=0
